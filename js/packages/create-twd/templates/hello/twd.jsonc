{
  "$schema": "https://raw.githubusercontent.com/rosskukulinski/twd/master/schema/twd.schema.json",
  "name": "hello",
  "tailnet": {
    // the workload node's tags (your policy must let tag:twd own them)
    "tags": ["tag:twd-wl-hello"],
    // declared dependencies; `twd deploy` preflights these grants
    "connects": ["tag:db"]
  }
}

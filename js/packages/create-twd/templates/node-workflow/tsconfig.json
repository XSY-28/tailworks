{
  // Type-checking only (`npx tsc --noEmit`): twd bundles the app itself.
  // worker-configuration.d.ts is the process.env typing `twd types` writes.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src", "workflows", "worker-configuration.d.ts"]
}

{
  "name": "refunds",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // the workload name, for the `tw approve` hint (tw init sets it)
  "vars": { "APP_NAME": "refunds" },
  "durable_objects": {
    "bindings": [{ "name": "RefundAgent", "class_name": "RefundAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RefundAgent"] }],
  // A Cloudflare Workflow, run by workerd's built-in engine on tailworks.
  "workflows": [{ "name": "refund", "binding": "REFUND_WORKFLOW", "class_name": "RefundWorkflow" }]
}

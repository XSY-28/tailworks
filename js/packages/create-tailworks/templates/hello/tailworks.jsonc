{
  "$schema": "https://raw.githubusercontent.com/rosskukulinski/tailworks/master/schema/tailworks.schema.json",
  "name": "hello",
  "tailnet": {
    // the workload node's tags (your policy must let tag:tw own them)
    "tags": ["tag:tw-wl-hello"],
    // what it calls on your tailnet, by tag (e.g. ["tag:db"]); `tw deploy`
    // checks your policy grants them, and `tw policy --apply` adds the grants
    "connects": []
  }
}
